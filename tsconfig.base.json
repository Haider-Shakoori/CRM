{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,

    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,

    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@crm/design-tokens": ["packages/design-tokens/src/index.ts"],
      "@crm/design-tokens/*": ["packages/design-tokens/src/*"],
      "@crm/ui": ["packages/ui/src/index.ts"],
      "@crm/ui/*": ["packages/ui/src/*"],
      "@crm/shared-types": ["packages/shared-types/src/index.ts"],
      "@crm/shared-types/*": ["packages/shared-types/src/*"],
      "@crm/configuration": ["packages/configuration/src/index.ts"],
      "@crm/configuration/*": ["packages/configuration/src/*"],
      "@crm/mock-services": ["packages/mock-services/src/index.ts"],
      "@crm/mock-services/*": ["packages/mock-services/src/*"],
      "@crm/localization": ["packages/localization/src/index.ts"],
      "@crm/localization/*": ["packages/localization/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".astro", "coverage", "playwright-report", "test-results"]
}
