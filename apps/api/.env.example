APP_NAME="CRM Platform API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=crm
DB_USERNAME=crm
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
MAIL_MAILER=log
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_APP_URL=http://localhost:5173

# STRIPE: disabled until all secrets, Price IDs, return URL, webhooks and tests are ready.
# Only sk_test_ keys accepted by the current integration; no live charges are enabled.
CRM_STRIPE_ENABLED=false
CRM_STRIPE_MODE=test
CRM_STRIPE_SECRET_KEY=
CRM_STRIPE_WEBHOOK_SECRET=
CRM_STRIPE_PRICE_TEAM=
CRM_STRIPE_PRICE_BUSINESS=
CRM_STRIPE_RETURN_URL=http://localhost:5173/crm/subscription
