{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "astro/client"],
    "jsx": "react-jsx",
    "allowJs": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.astro",
    ".astro/types.d.ts",
    "astro.config.mjs"
  ]
}
