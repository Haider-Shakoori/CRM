---
/**
 * Pricing page.
 *
 * The interface is complete and interactive: billing interval, seat count, currency
 * restatement, plan comparison with expand/collapse, and the enterprise sales route all
 * work. What it deliberately is not is a payment page — no provider is connected, and
 * every price is an illustrative placeholder drawn from `@crm/configuration`.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/site/Section.astro';
import PricingTable from '@/components/islands/PricingTable';
import PlanComparisonTable from '@/components/islands/PlanComparisonTable';
import { plans, pricingFaq, addOns, demoPolicy } from '@crm/configuration';
import { Check, ShieldAlert } from 'lucide-react';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: pricingFaq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout
  title="Pricing"
  description="Compare CRM plans by users, modules and limits. Illustrative pricing for design review — no commercial offer has been finalised."
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Pricing' }]}
  jsonLd={faqJsonLd}
>
  <section class="relative overflow-hidden border-b border-border-subtle" aria-labelledby="pricing-heading">
    <div class="surface-mesh pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="mx-auto w-full max-w-[var(--container-wide)] px-4 pb-10 pt-14 sm:px-6 sm:pt-20 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-2xs font-semibold uppercase tracking-[0.14em] text-brand-fg">Pricing</p>
        <h1 id="pricing-heading" class="mt-4 text-4xl font-bold tracking-tight text-fg sm:text-5xl">
          Plans that scale from one person to an enterprise
        </h1>
        <p class="mt-5 text-base leading-relaxed text-muted">
          Choose a plan by seat count and modules, and see exactly what changes before you commit. Switch between
          monthly and annual billing, restate prices in another currency, and expand the full feature comparison.
        </p>
      </div>

      <!--
        The illustrative-pricing notice is not a footnote here. These are placeholder
        figures, and presenting them as an offer would be misleading.
      -->
      <div class="mx-auto mt-8 flex max-w-2xl items-start gap-2.5 rounded-lg border border-warning/30 bg-warning-subtle px-4 py-3">
        <ShieldAlert className="mt-0.5 size-4 shrink-0 text-warning-fg" aria-hidden="true" />
        <p class="text-xs leading-relaxed text-warning-fg">
          <span class="font-semibold">Illustrative pricing.</span>
          Plan names, prices, limits and quotas on this page are placeholders used to design and test the pricing
          interface. No pricing strategy has been finalised, no payment provider is connected, and nothing here is a
          commercial offer.
        </p>
      </div>
    </div>
  </section>

  <!-- ================================================== PLAN CARDS + CALCULATOR -->
  <Section borderless width="wide">
    <PricingTable client:visible />
  </Section>

  <!-- =========================================================== ADD-ONS -->
  <Section
    eyebrow="Optional modules"
    title="Add only the capabilities you need"
    body="Some capabilities live in a plan tier; others are add-ons you can take per user, per unit or as a flat monthly fee. Prices are illustrative."
  >
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        addOns.map((addOn) => (
          <li class="flex flex-col gap-2.5 rounded-xl border border-border-subtle bg-surface p-4">
            <div class="flex items-start justify-between gap-2">
              <span class="text-sm font-semibold text-fg">{addOn.name}</span>
              <span class="shrink-0 rounded-full bg-neutral-subtle px-2 py-0.5 text-2xs font-medium text-muted">
                {addOn.pricingModel.replace(/_/g, ' ')}
              </span>
            </div>
            <p class="text-2xs leading-relaxed text-muted">{addOn.description}</p>
            <p class="mt-auto pt-1">
              {addOn.requiresSalesContact ? (
                <span class="text-xs font-semibold text-fg">Contact sales</span>
              ) : (
                <>
                  <span class="text-md font-semibold tabular-nums text-fg">${addOn.price}</span>
                  <span class="text-2xs text-muted"> {addOn.unitLabel ?? 'per month'}</span>
                </>
              )}
            </p>
            <p class="text-2xs text-faint">
              Available on: {addOn.compatiblePlans.join(', ')}
            </p>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- ==================================================== FULL COMPARISON -->
  <Section
    eyebrow="Compare"
    title="Every capability, side by side"
    body="Rows marked with a dash are not available on that plan. Values such as a number or a tier name describe the limit rather than a simple yes or no."
  >
    <PlanComparisonTable client:visible />
  </Section>

  <!-- ========================================================== GUIDANCE -->
  <Section
    eyebrow="Choosing"
    title="Which plan fits, and when to move up"
    body="A short guide rather than a sales script. The right answer is usually the smallest plan that still covers the module you actually use every day."
  >
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        [
          {
            plan: 'Free',
            who: 'One person keeping track properly',
            move: 'Move up when a second person needs access, or when you need leads and shared pipelines.',
          },
          {
            plan: 'Starter',
            who: 'A small team of two to ten people',
            move: 'Move up when you need automation, journeys, quotes, SLAs or custom objects.',
          },
          {
            plan: 'Professional',
            who: 'A growing team with a real process',
            move: 'Move up when identity federation, sandbox environments or contract terms matter.',
          },
          {
            plan: 'Enterprise',
            who: 'Organisations with governance requirements',
            move: 'Talk to sales for negotiated volume terms, residency discussions and bespoke onboarding.',
          },
        ].map((item) => (
          <div class="flex flex-col gap-2 rounded-xl border border-border-subtle bg-surface p-4">
            <span class="text-sm font-semibold text-fg">{item.plan}</span>
            <p class="text-2xs leading-relaxed text-muted">
              <span class="font-medium text-fg">Who it suits: </span>
              {item.who}
            </p>
            <p class="mt-auto border-t border-border-subtle pt-2 text-2xs leading-relaxed text-muted">{item.move}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-border-subtle bg-surface p-5">
      <div class="space-y-1">
        <h3 class="text-sm font-semibold text-fg">Need a custom contract, residency discussion or volume pricing?</h3>
        <p class="text-xs text-muted">
          Large deployments are discussed directly. Include your expected seat count, regions and required modules so the
          first conversation is useful.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a
          href="/contact-sales"
          class="inline-flex h-10 items-center rounded-lg bg-brand px-4 text-sm font-semibold text-brand-contrast transition-colors hover:bg-brand-hover"
        >
          Contact sales
        </a>
        <a
          href="/book-a-demo"
          class="inline-flex h-10 items-center rounded-lg border border-border bg-surface px-4 text-sm font-semibold text-fg transition-colors hover:bg-hover"
        >
          Book a guided demo
        </a>
      </div>
    </div>
  </Section>

  <!-- =============================================================== FAQ -->
  <Section eyebrow="Questions" title="Pricing questions" width="content">
    <div class="mx-auto max-w-[var(--container-narrow)] divide-y divide-[var(--border-subtle)] border-y border-border-subtle">
      {
        pricingFaq.map((item) => (
          <details class="group py-1">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-4 text-start">
              <h3 class="text-sm font-medium text-fg">{item.question}</h3>
              <span
                class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full border border-border-subtle text-subtle transition-transform group-open:rotate-45"
                aria-hidden="true"
              >
                <svg viewBox="0 0 12 12" class="size-2.5" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M6 2v8M2 6h8" stroke-linecap="round" />
                </svg>
              </span>
            </summary>
            <p class="pb-4 pe-8 text-xs leading-relaxed text-muted">{item.answer}</p>
          </details>
        ))
      }
    </div>
    <p class="mx-auto mt-6 max-w-[var(--container-narrow)] text-center text-2xs text-faint">
      {demoPolicy.websiteFiguresNotice}
    </p>
  </Section>

  <!-- ========================================================== FINAL CTA -->
  <Section borderless>
    <div class="relative overflow-hidden rounded-2xl border border-border-subtle bg-surface px-6 py-12 text-center sm:px-12">
      <div class="surface-brand-soft pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
      <h2 class="text-2xl font-bold tracking-tight text-fg sm:text-3xl">Try the whole platform before choosing</h2>
      <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-muted">
        The trial includes {plans.find((plan) => plan.id === 'professional')?.trial?.days ?? 14} days of the Professional
        tier so you can evaluate modules rather than guess from a feature list.
      </p>
      <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/signup"
          class="inline-flex h-11 items-center rounded-lg bg-brand px-5 text-sm font-semibold text-brand-contrast shadow-sm transition-colors hover:bg-brand-hover"
        >
          Start free trial
        </a>
        <a
          href="/demo"
          class="inline-flex h-11 items-center rounded-lg border border-border bg-surface px-5 text-sm font-semibold text-fg shadow-xs transition-colors hover:bg-hover"
        >
          Explore the demo
        </a>
      </div>
      <ul class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
        {
          ['No credit card required', 'Reset your data at any time', 'Frontend demonstration build'].map((item) => (
            <li class="flex items-center gap-1.5 text-2xs text-muted">
              <Check className="size-3 text-success-fg" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </Section>
</BaseLayout>
